# Copy this file to .env and fill these values locally.
# Keep all secrets on the server. Never add them to frontend files or commit .env.
OPENROUTER_API_KEY="paste_your_openrouter_key_here"
APP_PASSWORD="choose_a_long_private_password"
SESSION_SECRET="replace_with_a_long_random_secret"
# Optional: openrouter/free automatically routes to an available free model.
OPENROUTER_MODEL="openrouter/free"
APP_URL="https://your-site.example"
